// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum DeviceStatus {
  ACTIVE        // working normally, in use
  INACTIVE      // not currently in use / unassigned
  MAINTENANCE   // temporarily out of service (repair, calibration, firmware update)
  RETIRED       // permanently decommissioned, no longer usable
}

enum AlertLevel {
  WARNING
  CRITICAL
}

model Patient {
  id          String    @id @default(uuid()) @db.Uuid
  firstName   String    
  lastName    String   
  birthDate   DateTime? @db.Date
  gender      String?
  bloodGroup  String?   
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  patientDevices PatientDevice[]
  alerts        Alert[]

}

model Device {
  id            String    @id @default(uuid()) @db.Uuid
  serialNumber  String    @unique
  deviceType    String    
  status        DeviceStatus    @default(INACTIVE)
  lastConnected DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  patientDevices PatientDevice[]

}

model PatientDevice {
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @db.Uuid 
  deviceId     String    @db.Uuid
  assignedAt   DateTime  @default(now()) @db.Timestamptz(3)
  unassignedAt DateTime? @db.Timestamptz(3)

  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  device       Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  measurements HealthMeasurement[]

  @@index([patientId])
  @@index([deviceId])

}

model HealthMeasurement {
  id                String        @id @default(uuid()) @db.Uuid
  patientDeviceId   String        @db.Uuid 
  heartRate         Int?          
  spo2              Int?
  temp              Decimal?      @db.Decimal(4, 1)
  systolicPressure  Int?         
  diastolicPressure Int?       
  respiratoryRate   Int?           
  timestamp         DateTime      @default(now()) @db.Timestamptz(3)

  patientDevice     PatientDevice @relation(fields: [patientDeviceId], references: [id], onDelete: Cascade)

  @@index([patientDeviceId])
  @@index([timestamp])
}

model Alert {
  id        String     @id @default(uuid()) @db.Uuid
  patientId String     @db.Uuid
  level     AlertLevel
  metric    String?
  value     Decimal?   @db.Decimal(10, 2)
  message   String?
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([level])
  @@index([createdAt])
  @@map("Alerts")
}

